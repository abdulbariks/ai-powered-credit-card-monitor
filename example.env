# Copy this file to .env and add your own values.
# The app starts in demo mode without an AI API key; RAG retrieval still works,
# but extraction/verification will use the deterministic demo verifier.
PORT=3000
# Paste a valid provider key here in your local .env file to enable AI extraction.
# Leave blank to use the safe deterministic demo fallback.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
MONITOR_INTERVAL_HOURS=24
